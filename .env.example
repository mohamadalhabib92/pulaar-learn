# Placeholders only. Do not put real secrets in the app.
# The old public example variable has been removed. Do not add it back.

# Server only (server/tts-proxy.mjs). Phase 2, off by default.
# USE_ELEVENLABS is false or omitted. REFERENCE_PULAAR_VOICE_ID stays YOUR_*.
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID
REFERENCE_PULAAR_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
PORT=YOUR_PORT
USE_ELEVENLABS=false
FEATURE_TTS=false
FEATURE_ACCOUNT=false

# Crash reports. Disabled when missing or when the value contains YOUR_. No request at startup.
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# Phase 2, not read by the client in this pass.
# EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# YOUR_AUDIO_BUCKET=YOUR_AUDIO_BUCKET
